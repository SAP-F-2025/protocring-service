server:
  host: 0.0.0.0
  port: 8080
  mode: debug # debug, release, test
  readtimeout: 10s
  writetimeout: 10s

database:
  host: localhost
  port: 5432
  user: postgres
  password: postgres
  dbname: protocring
  sslmode: disable
  maxopenconns: 25
  maxidleconns: 5
  connmaxlifetime: 5m

redis:
  host: localhost
  port: 6379
  password: ""
  db: 0

casdoor:
  endpoint: "https://your-casdoor-domain.com"
  clientid: "your-client-id"
  clientsecret: "your-client-secret"
  organization: "your-organization"
  application: "your-application"
  cert: |
    -----BEGIN CERTIFICATE-----
    YOUR_CERTIFICATE_CONTENT_HERE
    -----END CERTIFICATE-----

log:
  level: info # debug, info, warn, error
  format: json # json, console

# Worker configuration for async violation processing
worker:
  enabled: true                          # Enable/disable workers
  num_workers: 3                         # Number of concurrent worker goroutines
  stream_name: "violations:ingest"       # Redis Stream name for violations
  consumer_group: "violation-workers"    # Consumer group name
  batch_size: 10                         # Number of messages to consume per batch
  block_time: 5s                         # Block time for stream reads
  retry_attempts: 3                      # Number of retry attempts before DLQ
  dlq_stream: "violations:dlq"           # Dead Letter Queue stream name
