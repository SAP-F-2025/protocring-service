server:
  host: 0.0.0.0
  port: 8080
  mode: debug # debug, release, test
  readtimeout: 10s
  writetimeout: 10s

database:
  host: localhost
  port: 5432
  user: postgres
  password: postgres
  dbname: protocring
  sslmode: disable
  maxopenconns: 25
  maxidleconns: 5
  connmaxlifetime: 5m

redis:
  host: localhost
  port: 6379
  password: ""
  db: 0

casdoor:
  endpoint: "https://your-casdoor-domain.com"
  clientid: "your-client-id"
  clientsecret: "your-client-secret"
  organization: "your-organization"
  application: "your-application"
  cert: |
    -----BEGIN CERTIFICATE-----
    YOUR_CERTIFICATE_CONTENT_HERE
    -----END CERTIFICATE-----

log:
  level: info # debug, info, warn, error
  format: json # json, console

# Worker configuration for async violation processing
worker:
  enabled: true                          # Enable/disable workers
  num_workers: 10                        # Number of concurrent worker goroutines (increased for throughput)
  stream_name: "violations:ingest"       # Redis Stream name for violations
  consumer_group: "violation-workers"    # Consumer group name
  batch_size: 100                        # Number of messages to consume per batch from Redis
  block_time: 5s                         # Block time for stream reads
  retry_attempts: 3                      # Number of retry attempts before DLQ
  dlq_stream: "violations:dlq"           # Dead Letter Queue stream name
  
  # Batch insert configuration (for high-throughput DB writes)
  insert_batch_size: 100                 # Records per DB batch insert
  insert_flush_timeout: 100ms            # Max time to wait before flushing batch
  stream_max_len: 500000                 # Redis stream max length (MAXLEN ~)
  
  # Retry worker configuration (for claiming stale pending messages)
  retry_worker_enabled: true             # Enable dedicated retry worker
  retry_check_interval: 30s              # How often to check for stale messages
  retry_min_idle_time: 1m                # Claim messages idle for > this duration
  retry_batch_size: 100                  # Max pending messages to check per cycle

# Storage configuration (DigitalOcean Spaces / S3-compatible)
storage:
  endpoint: "sgp1.digitaloceanspaces.com"     # Your region endpoint
  region: "sgp1"                              # Your DO region
  access_key_id: ""                           # From DO console
  secret_access_key: ""                       # From DO console  
  bucket_name: "sap-violations"               # Your bucket name
  cdn_endpoint: ""                            # Optional: CDN endpoint for public URLs
  presign_expiry: 5m                          # Presigned URL expiry time

# Redis for notification MQ (separate instance from worker Redis)
notification_redis:
  host: localhost
  port: 6380                                  # Different port or same host different DB
  password: ""
  db: 0

# Notification publishing configuration
notification:
  enabled: true
  stream_name: "proctoring-events"            # Redis Stream consumed by notification-service
  min_severity: 2                             # Only notify for severity >= HIGH (2=HIGH, 3=CRITICAL)
  cooldown_seconds: 60                        # Seconds between notifications for same violation type

# Assessment Service API client
assessment_service:
  base_url: "http://assessment-service:8080"  # K8s service name or URL
  service_key: ""                             # X-Service-Key header (inject from K8s secrets)
  timeout: 5s                                 # HTTP request timeout
  cache_ttl: 10m                              # Cache creator info for 10 minutes
